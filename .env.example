# Copy to .env and adjust. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Local (outside Docker): use localhost hosts
# Inside Docker Compose these are overridden in docker-compose.yml
DATABASE_URL=postgres://goldcorp:goldcorp@localhost:5434/goldcorp
REDIS_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=django-db

DJANGO_SETTINGS_MODULE=config.settings.local

# Phase 5 — paper trading (optional for simulated mode)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=True
PAPER_DEFAULT_MODE=simulated
